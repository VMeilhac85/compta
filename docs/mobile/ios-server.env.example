# Configuration publique/chemins serveur pour les releases iOS.
# Les identifiants et clés réels restent hors du dépôt.
MOBILE_IOS_BUNDLE_ID=expert.meilhac.maisonpilote
MOBILE_IOS_TEAM_ID=
MOBILE_IOS_MINIMUM_OS_VERSION=16.4
MOBILE_IOS_TESTFLIGHT_URL=
MOBILE_IOS_RELEASE_SCRIPT=/var/www/compta/mobile/ios/maison-pilote/scripts/release.sh
MOBILE_IOS_RELEASE_TIMEOUT_SECONDS=3600

# Session de la PWA iPhone. Le cookie reste hôte-only, HttpOnly, Secure et
# SameSite=Strict ; son chemin ne peut pas sortir de /api/mobile/v1.
MOBILE_IOS_PWA_AUTH_COOKIE=maison_pilote_ios_pwa
MOBILE_IOS_PWA_AUTH_COOKIE_PATH=/api/mobile/v1

# Vérification serveur App Store Connect avant activation d'une release. Le
# groupe doit être externe, avoir un lien public et appartenir à l'application.
# Utiliser une clé API d'équipe autorisée à gérer l'application et TestFlight.
MOBILE_IOS_ASC_APP_ID=
MOBILE_IOS_ASC_BETA_GROUP_ID=
MOBILE_IOS_ASC_BETA_LOCALE=fr-FR
MOBILE_IOS_ASC_BETA_DESCRIPTION=
MOBILE_IOS_ASC_BETA_FEEDBACK_EMAIL=
MOBILE_IOS_ASC_BETA_MARKETING_URL=https://maisonpilote.meilhac.expert
MOBILE_IOS_ASC_BETA_PRIVACY_POLICY_URL=
MOBILE_IOS_ASC_REVIEW_CONTACT_FIRST_NAME=
MOBILE_IOS_ASC_REVIEW_CONTACT_LAST_NAME=
MOBILE_IOS_ASC_REVIEW_CONTACT_EMAIL=
MOBILE_IOS_ASC_REVIEW_CONTACT_PHONE=
MOBILE_IOS_ASC_REVIEW_NOTES=
MOBILE_IOS_ASC_DEMO_ACCOUNT_REQUIRED=true
MOBILE_IOS_ASC_DEMO_ACCOUNT_NAME=
MOBILE_IOS_ASC_DEMO_ACCOUNT_PASSWORD_FILE=/etc/maison-pilote/app-store-connect/testflight-review.password
MOBILE_IOS_ASC_KEY_ID=
MOBILE_IOS_ASC_ISSUER_ID=
MOBILE_IOS_ASC_PRIVATE_KEY_FILE=/etc/maison-pilote/app-store-connect/AuthKey.p8
MOBILE_IOS_ASC_POLL_TIMEOUT_SECONDS=1200
MOBILE_IOS_ASC_POLL_INTERVAL_SECONDS=20
MOBILE_IOS_ASC_CONNECT_TIMEOUT_SECONDS=10
MOBILE_IOS_ASC_REQUEST_TIMEOUT_SECONDS=30

# Push iOS direct via APNs. AuthKey_XXXXXXXXXX.p8 doit rester hors dépôt et
# être lisible uniquement par PHP-FPM/worker. TestFlight utilise production.
MOBILE_APNS_ENABLED=true
MOBILE_APNS_ENVIRONMENT=production
MOBILE_APNS_TEAM_ID=
MOBILE_APNS_KEY_ID=
MOBILE_APNS_TOPIC=expert.meilhac.maisonpilote
MOBILE_APNS_PRIVATE_KEY_FILE=/etc/maison-pilote/apns/AuthKey.p8
MOBILE_APNS_CONNECT_TIMEOUT_SECONDS=5
MOBILE_APNS_TIMEOUT_SECONDS=20
